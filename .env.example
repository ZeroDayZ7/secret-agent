# KMS Service Integration
SECRET_AGENT_KMS_URL=http://kms-service:8080
SECRET_AGENT_KMS_SECRETS_PATH=/api/v1/agent/credentials/issue
SECRET_AGENT_KMS_BATCH_SECRETS_PATH=/api/v1/agent/credentials/issue-batch
SECRET_AGENT_KMS_TIMEOUT_SECS=10

# Client & Auth Metadata
SECRET_AGENT_CLIENT_ID=auth-service

# Paths & Socket
SECRET_AGENT_SOCKET_PATH=/var/run/agent-sockets/agent.sock
SECRET_AGENT_SOCKET_MODE=0o660
SECRET_AGENT_MANIFEST_PATH=/app/manifest.yaml

# Logging
RUST_LOG=warn,secret_agent=debug
LOG__FORMAT=pretty

# Renewal & Intervals (w sekundach)
SECRET_AGENT_RENEWAL_LOOKAHEAD_SECS=900
SECRET_AGENT_DEFAULT_TTL_SECS=86400
SECRET_AGENT_POLL_INTERVAL_SECS=86400